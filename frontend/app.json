{
  "expo": {
    "name": "BolKhata",
    "slug": "bolkhata",
    "scheme": "bolkhata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/BKS-01-01.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bolkhata.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/BKS-01-01.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.bolkhata.app"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow BolKhata to access your microphone for recording voice khata entries.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "web": {
      "favicon": "./assets/BKS-01-01.png"
    },
    "extra": {
      "eas": {
        "projectId": "cd3ffee2-5ef1-4389-b293-e8c2b6ff3556"
      }
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
