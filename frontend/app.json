{
  "expo": {
    "name": "BolKhata",
    "slug": "salman-ahmad",
    "scheme": [
      "bolkhata",
      "veldger"
    ],
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/BKS-01-01.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bolkhata.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/BKS-01-01.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.bolkhata.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/BKS-01-01.png"
    },
    "owner": "ahmmikuns-team",
    "extra": {
      "eas": {
        "projectId": "eea9a22d-3e21-4168-b71c-34e893c4ff04"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to record voice entries.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
