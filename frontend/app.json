{
  "expo": {
    "name": "Veldger",
    "slug": "veldger",
    "scheme": "veldger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/BKS-01-01.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.veldger.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/BKS-01-01.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.veldger.app"
    },
    "web": {
      "favicon": "./assets/BKS-01-01.png"
    }
  }
}
