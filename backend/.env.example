# Server
PORT=3000
NODE_ENV=production

# Supabase Credentials (Required)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=

# CORS allowlist for browser callers (native apps don't need to be listed).
# Extra origins can be appended comma-separated. LAN Expo hosts are allowed
# automatically outside production.
FRONTEND_URL=http://localhost:8081
ALLOWED_ORIGINS=

# Voice quota & admin bypass
# Comma-separated emails that bypass the daily voice limit (no defaults).
DEVELOPER_EMAILS=
DAILY_VOICE_LIMIT=50

# AI & Voice Services (Optional / Feature specific)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Abort timeout (ms) applied to every AI provider call
AI_TIMEOUT_MS=30000

# Log raw transcriptions/commands while developing (PII — keep off in prod)
VOICE_DEBUG=false
